{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BIMModelApproval",
  "description": "User approval gate record locking a specific model version before BIM construction",
  "type": "object",
  "required": ["projectName", "modelHash", "status", "timestamp", "approvedParameters"],
  "properties": {
    "projectName": { "type": "string" },
    "modelHash": { "type": "string" },
    "status": { "type": "string", "enum": ["approved", "rejected", "pending"] },
    "approvedBy": { "type": "string" },
    "timestamp": { "type": "string" },
    "dxfHash": { "type": "string" },
    "configHash": { "type": "string" },
    "approvalMethod": { "type": "string" },
    "approvedParameters": {
      "type": "object",
      "required": ["storeyCount", "wallHeight", "slabThickness"],
      "properties": {
        "storeyCount": { "type": "integer", "minimum": 1 },
        "wallHeight": { "type": "number", "minimum": 1000 },
        "slabThickness": { "type": "number", "minimum": 50 },
        "exteriorWallThickness": { "type": "number" },
        "interiorWallThickness": { "type": "number" },
        "doorHeight": { "type": "number" },
        "windowHeight": { "type": "number" },
        "windowSillHeight": { "type": "number" },
        "roofType": { "type": "string" },
        "roofPitch": { "type": "number" },
        "roofOverhang": { "type": "number" },
        "roofThickness": { "type": "number" },
        "roofBaseElevation": { "type": "number" }
      }
    },
    "notes": { "type": "string" }
  }
}


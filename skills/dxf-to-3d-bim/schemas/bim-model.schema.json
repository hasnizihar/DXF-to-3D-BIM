{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BIMIntermediateModel",
  "description": "Normalized, engine-independent 3D Building Information Model reconstructed from 2D architectural DXF geometry and user requirements.",
  "type": "object",
  "required": [
    "schemaVersion",
    "metadata",
    "status",
    "units",
    "levels",
    "walls",
    "openings",
    "floors",
    "rooms",
    "assumptions",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "required": ["projectName", "createdAt"],
      "properties": {
        "projectName": { "type": "string" },
        "author": { "type": "string" },
        "sourceDxfPath": { "type": "string" },
        "sourceJsonPath": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "awaiting_approval", "approved", "rejected", "built", "failed"]
    },
    "units": {
      "type": "object",
      "required": ["sourceUnits", "normalizedUnits", "scaleFactor"],
      "properties": {
        "sourceUnits": { "type": "string", "enum": ["mm", "cm", "m", "in", "ft", "unspecified"] },
        "normalizedUnits": { "type": "string", "const": "mm" },
        "scaleFactor": { "type": "number", "minimum": 0 },
        "originOffset": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "elevation"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "elevation": { "type": "number" },
          "height": { "type": "number", "minimum": 0 },
          "index": { "type": "integer", "minimum": 1 },
          "floorToFloorHeight": { "type": "number", "minimum": 0 },
          "storeyType": { "type": "string", "enum": ["ground", "upper", "roof_datum"] },
          "provenance": { "type": "string", "enum": ["explicit_dxf", "user_configured_repeated", "user_configured_custom", "default"] }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "classification", "start", "end", "thickness", "height", "levelId"],
        "properties": {
          "id": { "type": "string" },
          "classification": { "type": "string", "enum": ["exterior", "interior"] },
          "start": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "end": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "thickness": { "type": "number", "minimum": 0 },
          "height": { "type": "number", "minimum": 0 },
          "levelId": { "type": "string" },
          "baseElevation": { "type": "number" },
          "material": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "sourceEntities": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "wallId", "center", "width", "height"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["door", "window"] },
          "wallId": { "type": "string" },
          "center": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "width": { "type": "number", "minimum": 0 },
          "height": { "type": "number", "minimum": 0 },
          "sillHeight": { "type": "number" },
          "levelId": { "type": "string" },
          "swing": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "levelId", "thickness", "boundary"],
        "properties": {
          "id": { "type": "string" },
          "levelId": { "type": "string" },
          "thickness": { "type": "number", "minimum": 0 },
          "elevation": { "type": "number" },
          "boundary": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          },
          "structuralRole": {
            "type": "string",
            "enum": ["architectural", "structural", "ground_bearing", "roof_slab"]
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "levelId"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "levelId": { "type": "string" },
          "approximateArea": { "type": "number", "minimum": 0 },
          "labelPosition": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "roofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "roofType", "levelId"],
        "properties": {
          "id": { "type": "string" },
          "roofType": { "type": "string", "enum": ["none", "flat", "gable", "hip", "shed"] },
          "levelId": { "type": "string" },
          "baseElevation": { "type": "number" },
          "pitchDegrees": { "type": "number", "minimum": 0, "maximum": 89.9 },
          "overhang": { "type": "number", "minimum": 0 },
          "thickness": { "type": "number", "minimum": 0 },
          "boundary": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          },
          "ridgeEndpoints": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "ridgeElevation": { "type": "number" },
          "gableEdgeIndices": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "areaM2": { "type": "number", "minimum": 0 },
          "provenance": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "staircases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stairType", "levelId", "topLevelId", "start", "end", "width", "totalRise", "riserCount", "actualRiserHeight", "treadCount", "actualGoing"],
        "properties": {
          "id": { "type": "string" },
          "stairType": { "type": "string", "enum": ["straight", "l_shaped", "u_shaped"] },
          "levelId": { "type": "string" },
          "topLevelId": { "type": "string" },
          "baseElevation": { "type": "number" },
          "topElevation": { "type": "number" },
          "totalRise": { "type": "number", "minimum": 500 },
          "start": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "end": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "climbAngleDeg": { "type": "number" },
          "width": { "type": "number", "minimum": 500 },
          "riserCount": { "type": "integer", "minimum": 2 },
          "actualRiserHeight": { "type": "number", "minimum": 100 },
          "treadCount": { "type": "integer", "minimum": 1 },
          "actualGoing": { "type": "number", "minimum": 150 },
          "totalRun": { "type": "number", "minimum": 0 },
          "landings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["atRiser", "turnDegrees", "elevation"],
              "properties": {
                "atRiser": { "type": "integer", "minimum": 1 },
                "turnDegrees": { "type": "number" },
                "elevation": { "type": "number" },
                "dimensions": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          "railings": { "type": "boolean" },
          "headroomClearance": { "type": "number", "minimum": 1500 },
          "stairwellBoundary": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          },
          "provenance": { "type": "string", "enum": ["dxf_detected", "user_configured", "synthetic_test"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] }
        }
      }
    },
    "structuralGrids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "start", "end"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "start": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "end": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "orientation": { "type": "string", "enum": ["orthogonal", "rotated"] },
          "provenance": { "type": "string", "enum": ["detected", "configured", "inferred"] }
        }
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "profile", "width", "depth", "at", "levelId", "topLevelId"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "profile": { "type": "string", "enum": ["rectangular", "circular"] },
          "width": { "type": "number", "minimum": 100 },
          "depth": { "type": "number", "minimum": 100 },
          "diameter": { "type": "number", "minimum": 100 },
          "at": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "angle": { "type": "number" },
          "levelId": { "type": "string" },
          "topLevelId": { "type": "string" },
          "height": { "type": "number", "minimum": 500 },
          "baseOffset": { "type": "number" },
          "material": { "type": "string" },
          "structuralRole": { "type": "string", "enum": ["load_bearing", "non_load_bearing"] },
          "gridIntersection": { "type": "string" },
          "sourceEntities": { "type": "array", "items": { "type": "string" } },
          "provenance": { "type": "string", "enum": ["detected", "configured", "inferred", "synthetic_test"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] }
        }
      }
    },
    "beams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "width", "depth", "start", "end", "levelId"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "profile": { "type": "string", "enum": ["rectangular", "circular"] },
          "width": { "type": "number", "minimum": 100 },
          "depth": { "type": "number", "minimum": 100 },
          "start": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "end": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "startColumnId": { "type": "string" },
          "endColumnId": { "type": "string" },
          "levelId": { "type": "string" },
          "offset": { "type": "number" },
          "endOffset": { "type": "number" },
          "material": { "type": "string" },
          "beamType": { "type": "string", "enum": ["primary", "secondary"] },
          "sourceEntities": { "type": "array", "items": { "type": "string" } },
          "provenance": { "type": "string", "enum": ["detected", "configured", "inferred", "synthetic_test"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] }
        }
      }
    },
    "foundations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "foundationType", "width", "thickness", "levelId"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "foundationType": { "type": "string", "enum": ["isolated", "strip"] },
          "at": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "points": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "minItems": 2
          },
          "width": { "type": "number", "minimum": 200 },
          "depth": { "type": "number", "minimum": 200 },
          "thickness": { "type": "number", "minimum": 100 },
          "offset": { "type": "number" },
          "angle": { "type": "number" },
          "levelId": { "type": "string" },
          "supportingElementId": { "type": "string" },
          "material": { "type": "string" },
          "provenance": { "type": "string", "enum": ["detected", "configured", "inferred", "synthetic_test"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "description", "assumedValue"],
        "properties": {
          "id": { "type": "string" },
          "target": { "type": "string" },
          "description": { "type": "string" },
          "assumedValue": {},
          "status": { "type": "string", "enum": ["unresolved", "approved", "modified"] }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["isApproved"],
      "properties": {
        "isApproved": { "type": "boolean" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "modelHash": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}

